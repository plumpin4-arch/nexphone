# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริงของคุณ (ห้าม commit ไฟล์ .env ขึ้น GitHub)
DATABASE_URL=postgres://USER:PASSWORD@ep-xxxx.neon.tech/neondb?sslmode=require
PORT=3000
JWT_SECRET=เปลี่ยนเป็นข้อความลับยาวๆ-ของคุณเอง
DISCORD_WEBHOOK_URL=

# Cloudinary — สำหรับเก็บรูปสินค้าที่อัปโหลดผ่านหน้า admin ให้อยู่ถาวร (ไม่หายเมื่อ Render redeploy)
# สมัครฟรีที่ cloudinary.com แล้วสร้าง Upload Preset แบบ Unsigned
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
